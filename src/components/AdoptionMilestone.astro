---
import type { WindowsRelease } from "../data/windows";
import { getWindowsAdoptionMilestone, getWindowsAdoptionScale } from "../data/windows-adoption";
import { getMarketShare } from "../data/windows-market-share";
import adoptionInteractions from "../adoption-milestone.js?raw";

interface Props {
  release: WindowsRelease;
}

const { release } = Astro.props;
const milestone = getWindowsAdoptionMilestone(release.id);
const scale = getWindowsAdoptionScale(milestone.valueMillions);
const share = getMarketShare(release.id);
---

<section
  class="release-adoption"
  data-adoption-milestone
  data-adoption-value={milestone.valueMillions}
  data-adoption-display={milestone.display}
  style={`--adoption-scale:${scale}`}
  aria-labelledby="adoption-heading"
>
  <div class="release-adoption-heading">
    <p class="eyebrow">Published adoption milestone</p>
    <h2 id="adoption-heading">Users and installed reach</h2>
  </div>
  <div class="release-adoption-number">
    {/* The real figure is server-rendered, not counted up from a hardcoded 0.
        With JavaScript off — or before the inline script below runs on a slow
        connection — a "0" here would be a false number, not a pending one.
        adoption-milestone.js zeroes it itself, but only once it knows it is
        about to animate. */}
    <strong data-adoption-count aria-label={`${milestone.display}, ${milestone.detail}`}>{milestone.display}</strong>
    <span>{milestone.period}</span>
  </div>
  {/* The share of desktops, beside the copies shipped. Deliberately the
      smaller of the two figures: reach is what this section is about, and
      share is the check on it. Each figure states its own basis, because the
      services measuring them do not all use the same denominator. */}
  <div class="release-adoption-share" data-market-share data-market-measured={String(share.measured)}>
    <p class="release-adoption-share-label">Share of desktops</p>
    {share.measured ? (
      <>
        <strong data-market-value>{share.display}</strong>
        <span>{share.when} · {share.basis}</span>
      </>
    ) : (
      <>
        <strong data-market-value aria-label="Not measured for this period">—</strong>
        <span>not measured in this period</span>
      </>
    )}
  </div>

  <div class="release-adoption-detail">
    <div class="release-adoption-meter" aria-hidden="true"><span data-adoption-meter></span></div>
    <p>{milestone.detail}. Historical reporting varies between copies, licences, installations, and active devices.</p>
    <a href={milestone.sourceUrl} target="_blank" rel="noreferrer">Source: {milestone.sourceLabel}</a>
    <p class="release-adoption-share-note" data-market-note>{share.note}</p>
    {share.source && (
      <a href={share.source.url} target="_blank" rel="noreferrer">Share source: {share.source.label}</a>
    )}
  </div>
</section>

<script is:inline set:html={adoptionInteractions} />
