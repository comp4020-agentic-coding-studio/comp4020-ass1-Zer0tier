---
import type { WindowsRelease } from "../data/windows";
import { appSlug } from "../data/windows-memories";
import { getAppStory } from "../data/windows-apps";
import type { WindowsMemoryScene } from "../data/windows-memories";
import RelearningEvidence from "./RelearningEvidence.astro";

interface Props {
  release: WindowsRelease;
  scene: WindowsMemoryScene;
  base: string;
}

const { release, scene, base } = Astro.props;
const dialogId = `memory-dialog-${release.id}`;
const appDialogId = `app-dialog-${release.id}`;

---

<section class:list={["memory-scene", `memory-scene-${release.id}`]} aria-labelledby={`memory-heading-${release.id}`} data-memory-scene data-relearning-content>
  <header class="memory-scene-heading">
    <div>
      <p class="eyebrow">Desktop time capsule</p>
      <h2 id={`memory-heading-${release.id}`}>The apps everyone knew</h2>
    </div>
    <p>Four popular programs that made this era feel familiar. Open any of them for how it reached this many people, and what it left behind for the next redesign to keep or break.</p>
  </header>

  <RelearningEvidence release={release} context="memory" />

  <div class="memory-desktop" aria-label={`A nostalgic ${release.name} software scene`}>
    <div class="memory-app-stack" aria-label="Defining software applications">
      {scene.applications.map((application, index) => (
        <article class="memory-app-window" data-app-index={index + 1} data-app={appSlug(application.name)}>
          <header>
            <span class="memory-title-icon" aria-hidden="true"></span>
            <strong>{application.name}</strong>
            <span class="memory-window-controls" aria-hidden="true"><i></i><i></i><i></i></span>
          </header>
          <div class="memory-app-content">
            <img
              class="memory-app-icon"
              src={`${base}${application.icon}`}
              alt=""
              width="96"
              height="96"
              loading="lazy"
              decoding="async"
            />
            <div class="memory-app-copy">
              <span class="memory-app-kind">{application.kind}</span>
              {/* The link is on the title, not the card, so it has one clear
                  accessible name; .memory-app-link::after stretches its hit
                  area over the whole window. Nothing else in the card is
                  interactive, so there is nothing for the overlay to cover. */}
              <h3><a
                class="memory-app-link"
                href={`${base}${release.slug}/apps/${appSlug(application.name)}/`}
                data-app-open
                data-app-name={application.name}
                data-app-kind={application.kind}
                data-app-why={getAppStory(release.id, appSlug(application.name)).why}
                data-app-relearn={getAppStory(release.id, appSlug(application.name)).relearn}
                data-app-source-label={getAppStory(release.id, appSlug(application.name)).source.label}
                data-app-source-url={getAppStory(release.id, appSlug(application.name)).source.url}
                aria-haspopup="dialog"
                aria-controls={appDialogId}
              >{application.name}</a></h3>
              <p>{application.detail}</p>
              <span class="memory-app-more" aria-hidden="true">Why it took over &rarr;</span>
            </div>
            <div class="memory-mini-interface" aria-hidden="true"><i></i><i></i><i></i></div>
          </div>
        </article>
      ))}
    </div>

    <div class="memory-desktop-label" aria-hidden="true"><span></span>Popular on {release.name}</div>
  </div>

  <section class="memory-reviews" aria-labelledby={`memory-reviews-heading-${release.id}`} data-memory-reviews>
    <header class="memory-reviews-heading">
      <div>
        <p class="eyebrow">Period reviews</p>
        <h3 id={`memory-reviews-heading-${release.id}`}>What reviewers said back then</h3>
      </div>
      <p>Three short excerpts from reviews and reported reactions published around {release.name}’s release. Select one to open it in an era-matched window.</p>
    </header>

    <div class="memory-bubbles" aria-label={`Contemporaneous reviews of ${release.name}`}>
      {scene.memories.map((memory, index) => (
        <article class="memory-review-card">
          <button
            class="memory-bubble"
            type="button"
            data-memory-bubble
            data-memory-handle={memory.handle}
            data-memory-quote={memory.quote}
            data-memory-context={memory.context}
            data-memory-source-label={memory.sourceLabel}
            data-memory-source-url={memory.sourceUrl}
            data-memory-index={index + 1}
            aria-haspopup="dialog"
            aria-controls={dialogId}
            aria-label={`Open review excerpt from ${memory.handle}`}
          >
            <span class="memory-bubble-quote">“{memory.quote}”</span>
            <span class="memory-bubble-context">{memory.context}</span>
            <small>{memory.handle}</small>
          </button>
          <a class="memory-review-source" href={memory.sourceUrl} target="_blank" rel="noreferrer">
            Source: {memory.sourceLabel}<span aria-hidden="true"> ↗</span>
          </a>
        </article>
      ))}
    </div>

    <p class="memory-disclaimer">Every excerpt is verbatim from a contemporaneous publication. Follow its source to read the original in context.</p>
  </section>

  <dialog class="memory-dialog" id={dialogId} data-memory-dialog aria-labelledby={`${dialogId}-title`}>
    <div class="memory-dialog-window">
      <header>
        <span id={`${dialogId}-title`} data-memory-dialog-title>Time capsule memory</span>
        <button type="button" data-memory-close aria-label="Close memory">×</button>
      </header>
      <div class="memory-dialog-content">
        <p class="memory-dialog-context" data-memory-dialog-context></p>
        <blockquote data-memory-dialog-quote></blockquote>
        <p class="memory-dialog-handle" data-memory-dialog-handle></p>
        <a class="memory-dialog-source" data-memory-dialog-source href="#" target="_blank" rel="noreferrer">Read the original review</a>
      </div>
    </div>
  </dialog>

  {/* Same era-matched window as the review dialog. The card is still a real
      link to a real page, so with JavaScript off it navigates there; the
      script calls preventDefault and opens this instead. */}
  <dialog class="memory-dialog app-dialog" id={appDialogId} data-app-dialog aria-labelledby={`${appDialogId}-title`}>
    <div class="memory-dialog-window">
      <header>
        <span id={`${appDialogId}-title`} data-app-dialog-title>Popular software</span>
        <button type="button" data-app-close aria-label="Close">×</button>
      </header>
      <div class="memory-dialog-content">
        <p class="memory-dialog-context" data-app-dialog-kind></p>
        <p class="app-dialog-label">Why it took over</p>
        <p class="app-dialog-body" data-app-dialog-why></p>
        <p class="app-dialog-label">What it left behind</p>
        <p class="app-dialog-body app-dialog-relearn" data-app-dialog-relearn></p>
        <a class="memory-dialog-source" data-app-dialog-source href="#" target="_blank" rel="noreferrer">Reference</a>
      </div>
    </div>
  </dialog>
</section>
