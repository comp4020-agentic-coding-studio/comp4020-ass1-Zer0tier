---
import type { StartupSound } from "../data/windows-audio";

interface Props {
  releaseName: string;
  sound: StartupSound;
  base: string;
}

const { releaseName, sound, base } = Astro.props;
const src = sound.src ? `${base}${sound.src}` : undefined;
---

<aside class="startup-sound" data-startup-sound data-silent={src ? undefined : "true"} aria-label={`${releaseName} startup sound`}>
  <span class="sound-glyph" aria-hidden="true">{src ? "◖))" : "◖×"}</span>
  <div>
    <strong>{sound.label}</strong>
    <p data-sound-status data-state={src ? "ready" : "silent"} aria-live="polite">{sound.note}</p>
    <a href={sound.sourceUrl} target="_blank" rel="noreferrer">Sound history<span class="visually-hidden"> for {releaseName}</span></a>
  </div>
  {src && <button type="button" data-sound-play>Play sound</button>}
  {src && <audio src={src} preload="none" data-startup-audio />}
</aside>
