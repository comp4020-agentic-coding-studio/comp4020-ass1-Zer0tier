---
import type { WindowsRelease } from "../data/windows";
import { getWindowsAdoptionMilestone, getWindowsAdoptionScale } from "../data/windows-adoption";

interface Props {
  releases: WindowsRelease[];
  base: string;
}

const { releases, base } = Astro.props;
const titles: Record<string, string> = {
  win1: "MS-DOS Executive",
  win2: "Control Panel",
  win3: "Program Manager",
  win95: "Windows Explorer",
  win98: "My Computer",
  win2000: "Control Panel",
  winxp: "My Pictures",
  vista: "Computer",
  win7: "Libraries",
  win8: "Start",
  win10: "Settings",
  win11: "Settings",
};
const timelineReleases = releases.map((release) => ({ release, adoption: getWindowsAdoptionMilestone(release.id) }));
const firstAdoption = timelineReleases[0].adoption;
---

<main id="main" class="timeline-entry" data-timeline-entry>
  <h1 class="sr-only">Windows Desktop Evolution</h1>
  <nav class="timeline-selector" data-timeline-selector aria-label="Windows version timeline">
    <div class="timeline-selector-track">
      <span class="timeline-selector-highlight" data-timeline-highlight aria-hidden="true"></span>
      {timelineReleases.map(({ release }, index) => (
        <a
          href={`${base}${release.slug}/`}
          data-timeline-step
          data-step-index={index}
          data-active={index === 0 ? "true" : "false"}
          aria-current={index === 0 ? "step" : undefined}
          aria-label={`${release.name}, ${release.year}`}
        >
          <strong>{release.shortName}</strong>
          <span>{release.year}</span>
        </a>
      ))}
    </div>
    <p class="sr-only" data-timeline-keyboard-status aria-live="polite">Windows 1.0 selected. Use Left Arrow or A, and Right Arrow or D, to move through the timeline.</p>
  </nav>
  <div class="timeline-window" data-timeline-window aria-live="polite">
    <header class="timeline-titlebar">
      <span data-timeline-title>{titles[releases[0].id]}</span>
      <div aria-hidden="true"><i></i><i></i><i></i></div>
    </header>

    <div class="timeline-scenes">
      {timelineReleases.map(({ release, adoption }, index) => (
        <article
          class:list={["timeline-scene", `timeline-scene-${release.id}`]}
          data-timeline-scene
          data-id={release.id}
          data-name={release.name}
          data-year={release.year}
          data-title={titles[release.id]}
          data-href={`${base}${release.slug}/`}
          data-reach-value={adoption.valueMillions}
          data-reach-display={adoption.display}
          data-reach-period={adoption.period}
          data-reach-detail={adoption.detail}
          data-reach-source={adoption.sourceLabel}
          data-reach-source-url={adoption.sourceUrl}
          data-reach-scale={getWindowsAdoptionScale(adoption.valueMillions)}
          hidden={index !== 0}
        >
          <div class="timeline-logo">
            <span class="timeline-windows-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
            <p>Microsoft</p>
            <strong>{release.name}</strong>
            <small>{release.year}</small>
          </div>
          <div class="timeline-system-preview" aria-hidden="true">
            <div class="mini-system-title"><span>{titles[release.id]}</span><i></i><i></i><i></i></div>
            <div class="mini-system-menu"><i></i><i></i><i></i><i></i></div>
            <div class="mini-system-content"><span></span><span></span><span></span><span></span><span></span><span></span></div>
            <div class="mini-system-bar"><i></i><i></i><i></i><i></i></div>
          </div>
        </article>
      ))}
    </div>

    <section class="timeline-reach" data-timeline-reach aria-labelledby="timeline-reach-title">
      <div class="timeline-reach-heading">
        <p id="timeline-reach-title">Users / installed reach</p>
        <strong data-reach-count>{firstAdoption.display}</strong>
      </div>
      <div class="timeline-reach-data">
        <div class="timeline-reach-meter" aria-hidden="true"><span data-reach-meter style={`--reach-scale:${getWindowsAdoptionScale(firstAdoption.valueMillions)}`}></span></div>
        <p><span data-reach-period>{firstAdoption.period}</span> · <span data-reach-detail>{firstAdoption.detail}</span></p>
      </div>
      <p class="timeline-reach-source">Source: <a href={firstAdoption.sourceUrl} data-reach-source target="_blank" rel="noreferrer">{firstAdoption.sourceLabel}</a></p>
    </section>

    <footer class="timeline-statusbar">
      <span><b data-timeline-index>01</b> / {String(releases.length).padStart(2, "0")}</span>
      <p data-timeline-status>Windows 1.0 · 1985</p>
      <span>Scroll or use A/D · Click to enter</span>
    </footer>
  </div>

  <nav class="timeline-enter-nav" aria-label="Enter the selected Windows release">
    <a href={`${base}${releases[0].slug}/`} data-timeline-enter aria-label={`Enter the ${releases[0].name} page`}><span class="sr-only">Enter selected Windows release</span></a>
  </nav>
</main>
