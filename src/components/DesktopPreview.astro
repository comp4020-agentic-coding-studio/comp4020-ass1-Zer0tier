---
import CommandPrompt from "./CommandPrompt.astro";
import type { WindowsRelease } from "../data/windows";
import { getWindowsSystemAssetStyle } from "../data/windows-system-assets";

interface Props {
  release: WindowsRelease;
  base: string;
}

const { release, base } = Astro.props;
const classic = ["win95", "win98", "win2000"].includes(release.id);
const aero = ["vista", "win7"].includes(release.id);
const systemAssetStyle = getWindowsSystemAssetStyle(release.id, base);
---

<section class:list={["system-demo", `system-${release.id}`]} aria-labelledby="demo-heading">
  <div class="demo-heading-row">
    <div>
      <p class="eyebrow">Interactive system recreation</p>
      <h2 id="demo-heading">The {release.name} desktop</h2>
    </div>
    <p>Open Start, launch the period-correct command prompt, and use the window controls.</p>
  </div>

  <div class:list={["desktop", `desktop-${release.id}`]} data-desktop data-system-assets="original-extracted" style={systemAssetStyle}>
    {(release.id === "win1" || release.id === "win2") && (
      <>
        <article class="early-window early-executive" data-window>
          <header class="early-titlebar" data-window-handle>
            <button class="system-box" type="button" aria-label="Window menu"></button>
            <strong>MS-DOS Executive</strong>
            {release.id === "win2" && <button class="early-zoom" type="button" data-window-action="maximise" aria-label="Maximise window"></button>}
          </header>
          <nav class="early-menubar" aria-label="Application menu"><button type="button">File</button><button type="button">View</button><button type="button">Special</button></nav>
          <div class="early-path">C:\WINDOWS</div>
          <div class="file-table" aria-label="Files">
            <span>CALC.EXE</span><span>CALENDAR.EXE</span><span>CARDFILE.EXE</span><span>CLIPBRD.EXE</span><span>CONTROL.EXE</span><span>NOTEPAD.EXE</span><span>PAINT.EXE</span><span>REVERSI.EXE</span><span>WRITE.EXE</span><span>WIN.COM</span>
          </div>
        </article>
        <article class="early-window early-tool" data-window>
          <header class="early-titlebar"><button class="system-box" type="button" aria-label="Window menu"></button><strong>{release.id === "win1" ? "Clock" : "Control Panel"}</strong></header>
          {release.id === "win1" ? <div class="analogue-clock" aria-label="Clock showing ten past ten"><i></i><b></b></div> : <div class="early-controls"><button type="button">Color</button><button type="button">Desktop</button><button type="button">Mouse</button><button type="button">Keyboard</button></div>}
        </article>
        {release.id === "win1" && <div class="win1-iconbar" aria-label="Minimised applications"><button type="button"><span class="mini-icon write-icon"></span>Write</button><button type="button"><span class="mini-icon paint-icon"></span>Paint</button><button type="button"><span class="mini-icon terminal-icon"></span>MS-DOS</button></div>}
      </>
    )}

    {release.id === "win3" && (
      <>
        <article class="program-manager" data-window>
          <header class="classic-titlebar" data-window-handle><button class="caption-menu" type="button" aria-label="Window menu"></button><strong>Program Manager</strong><span><button type="button" data-window-action="minimise" aria-label="Minimise">_</button><button type="button" data-window-action="maximise" aria-label="Maximise">□</button></span></header>
          <nav class="classic-menubar" aria-label="Program Manager menu"><button type="button">File</button><button type="button">Options</button><button type="button">Window</button><button type="button">Help</button></nav>
          <section class="program-group"><header>Main</header><div class="program-icons"><button type="button"><span class="pixel-icon file-icon"></span>File Manager</button><button type="button"><span class="pixel-icon control-icon"></span>Control Panel</button><button type="button"><span class="pixel-icon print-icon"></span>Print Manager</button><button type="button" data-command-external-open><span class="pixel-icon terminal-icon"></span>MS-DOS Prompt</button></div></section>
          <section class="program-group accessories"><header>Accessories</header><div class="program-icons"><button type="button"><span class="pixel-icon write-icon"></span>Write</button><button type="button"><span class="pixel-icon paint-icon"></span>Paintbrush</button><button type="button"><span class="pixel-icon clock-icon"></span>Clock</button></div></section>
        </article>
      </>
    )}

    {classic && (
      <>
        <div class="desktop-shortcuts" aria-label="Desktop items">
          <button type="button" data-open-window><span class="pixel-icon computer-icon"></span>{release.id === "win2000" ? "My Computer" : "My Computer"}</button>
          <button type="button"><span class="pixel-icon network-icon"></span>{release.id === "win95" ? "Network Neighborhood" : "My Network Places"}</button>
          {release.id === "win98" && <button type="button"><span class="pixel-icon internet-icon"></span>Internet Explorer</button>}
          <button type="button"><span class="pixel-icon bin-icon"></span>Recycle Bin</button>
        </div>
        <article class="classic-window" data-window>
          <header class="classic-titlebar" data-window-handle><span><i class="title-icon"></i>{release.id === "win98" ? "My Computer" : release.id === "win2000" ? "Control Panel" : "Windows Explorer"}</span><div class="caption-buttons"><button type="button" data-window-action="minimise" aria-label="Minimise">_</button><button type="button" data-window-action="maximise" aria-label="Maximise">□</button><button type="button" data-window-action="close" aria-label="Close">×</button></div></header>
          <nav class="classic-menubar" aria-label="Window menu"><button type="button">File</button><button type="button">Edit</button><button type="button">View</button><button type="button">Help</button></nav>
          {release.id !== "win95" && <div class="classic-toolbar"><button type="button">Back</button><button type="button">Forward</button><span>Address</span><input aria-label="Address" value={release.id === "win98" ? "My Computer" : "Control Panel"} readonly /></div>}
          <div class="classic-content">
            <aside>{release.id === "win2000" ? <><b>See Also</b><a href="#details">Windows Update</a><a href="#details">Help and Support</a></> : <><b>Folders</b><span>Desktop</span><span>My Computer</span><span>Local Disk (C:)</span></>}</aside>
            <div class="drive-grid">
              <button type="button"><span class="pixel-icon drive-icon"></span>3½ Floppy (A:)</button>
              <button type="button"><span class="pixel-icon disk-icon"></span>Local Disk (C:)</button>
              <button type="button"><span class="pixel-icon cd-icon"></span>CD Drive (D:)</button>
              {release.id === "win2000" && <button type="button"><span class="pixel-icon control-icon"></span>Administrative Tools</button>}
            </div>
          </div>
          <footer>{release.id === "win95" ? "3 object(s)" : "4 object(s)"}</footer>
        </article>
        <div class="classic-taskbar">
          <button class="start-button" type="button" data-start-button aria-expanded="false"><span class="windows-flag" aria-hidden="true"><i></i><i></i><i></i><i></i></span>Start</button>
          {release.id === "win98" && <div class="quick-launch" aria-label="Quick Launch"><button type="button" aria-label="Show desktop"><span class="mini-monitor"></span></button><button type="button" aria-label="Internet Explorer"><span class="mini-internet"></span></button></div>}
          <button class="task-button" type="button" data-open-window>{release.id === "win2000" ? "Control Panel" : release.id === "win98" ? "My Computer" : "Windows Explorer"}</button>
          <time data-system-clock>4:20 PM</time>
        </div>
        <div class="classic-start-panel" data-start-panel hidden>
          <div class="start-rail">{release.name}</div>
          <div class="classic-start-items"><button type="button"><span class="pixel-icon programs-icon"></span>Programs <b>▶</b></button><button type="button"><span class="pixel-icon docs-icon"></span>Documents <b>▶</b></button><button type="button"><span class="pixel-icon settings-icon"></span>Settings <b>▶</b></button><button type="button"><span class="pixel-icon find-icon"></span>Find <b>▶</b></button><button type="button"><span class="pixel-icon help-icon"></span>Help</button><button type="button"><span class="pixel-icon run-icon"></span>Run...</button><hr /><button type="button"><span class="pixel-icon power-icon"></span>Shut Down...</button></div>
        </div>
      </>
    )}

    {release.id === "winxp" && (
      <>
        <div class="desktop-shortcuts xp-shortcuts" aria-label="Desktop items"><button type="button"><span class="pixel-icon computer-icon"></span>My Computer</button><button type="button"><span class="pixel-icon docs-icon"></span>My Documents</button><button type="button"><span class="pixel-icon bin-icon"></span>Recycle Bin</button></div>
        <article class="xp-window" data-window>
          <header data-window-handle><span><i class="title-icon"></i>My Pictures</span><div class="xp-caption"><button type="button" data-window-action="minimise" aria-label="Minimise">_</button><button type="button" data-window-action="maximise" aria-label="Maximise">□</button><button type="button" data-window-action="close" aria-label="Close">×</button></div></header>
          <nav aria-label="Window menu"><button type="button">File</button><button type="button">Edit</button><button type="button">View</button><button type="button">Favorites</button><button type="button">Tools</button><button type="button">Help</button></nav>
          <div class="xp-browser"><aside><section><b>Picture Tasks</b><a href="#details">View as a slide show</a><a href="#details">Order prints online</a><a href="#details">Print pictures</a></section><section><b>Other Places</b><a href="#details">My Documents</a><a href="#details">Shared Documents</a></section></aside><div class="xp-files"><button type="button"><span class="photo-thumb hills"></span>Bliss</button><button type="button"><span class="photo-thumb flowers"></span>Sample Pictures</button></div></div>
        </article>
        <div class="xp-taskbar"><button class="start-button xp-start" type="button" data-start-button aria-expanded="false"><span class="windows-flag" aria-hidden="true"><i></i><i></i><i></i><i></i></span><b>start</b></button><button class="xp-task" type="button" data-open-window>My Pictures</button><button class="command-task-launcher xp-command-task" type="button" data-command-external-open aria-label="Open Command Prompt"><img src={`${base}media/system-icons/Windows95MSDOSPrompt.png`} alt="" aria-hidden="true" /></button><time data-system-clock>4:20 PM</time></div>
        <div class="xp-start-panel" data-start-panel hidden><header><span class="user-avatar" aria-hidden="true"></span><strong>Alex</strong></header><div><section><button type="button"><span class="pixel-icon internet-icon"></span><b>Internet</b><small>Internet Explorer</small></button><button type="button"><span class="pixel-icon mail-icon"></span><b>E-mail</b><small>Outlook Express</small></button><hr /><button type="button"><span class="pixel-icon paint-icon"></span>Paint</button><button type="button"><span class="pixel-icon player-icon"></span>Windows Media Player</button></section><aside><button type="button"><b>My Documents</b></button><button type="button"><b>My Pictures</b></button><button type="button">My Computer</button><hr /><button type="button">Control Panel</button><button type="button">Help and Support</button></aside></div><footer><button type="button">Log Off</button><button type="button">Turn Off Computer</button></footer></div>
      </>
    )}

    {aero && (
      <>
        <div class="desktop-shortcuts aero-shortcuts" aria-label="Desktop items"><button type="button"><span class="glass-icon computer-glass"></span>Computer</button><button type="button"><span class="glass-icon bin-glass"></span>Recycle Bin</button></div>
        {release.id === "vista" && <aside class="vista-sidebar" aria-label="Windows Sidebar"><div class="gadget-clock"><i></i><b></b></div><div class="gadget-calendar"><strong>15</strong><span>April</span></div><div class="gadget-photo"></div></aside>}
        <article class="aero-window" data-window>
          <header data-window-handle><span>{release.id === "vista" ? "Computer" : "Libraries"}</span><div class="aero-caption"><button type="button" data-window-action="minimise" aria-label="Minimise">_</button><button type="button" data-window-action="maximise" aria-label="Maximise">□</button><button type="button" data-window-action="close" aria-label="Close">×</button></div></header>
          <div class="aero-command"><button type="button">Organize</button><button type="button">Views</button><label>Search <input aria-label="Search this window" /></label></div>
          <div class="aero-content"><aside><b>Favorite Links</b><span>Desktop</span><span>Downloads</span><span>Recent Places</span><b>Folders</b><span>Computer</span><span>Network</span></aside><section><h3>{release.id === "vista" ? "Hard Disk Drives" : "Libraries"}</h3><div class="library-grid"><button type="button"><span class="library-icon docs-library"></span>Documents</button><button type="button"><span class="library-icon music-library"></span>Music</button><button type="button"><span class="library-icon pictures-library"></span>Pictures</button><button type="button"><span class="library-icon video-library"></span>Videos</button></div></section></div>
        </article>
        <div class:list={["aero-taskbar", release.id === "win7" && "superbar"]}><button class="start-button aero-start" type="button" data-start-button aria-expanded="false" aria-label="Start"><span class="orb-flag"><i></i><i></i><i></i><i></i></span></button><button class="aero-task explorer-task" type="button" data-open-window aria-label="Windows Explorer"></button><button class="aero-task browser-task" type="button" aria-label="Internet Explorer"></button>{release.id === "vista" && <button class="aero-task command-task-launcher" type="button" data-command-external-open aria-label="Open Command Prompt"><img src={`${base}media/system-icons/Windows95MSDOSPrompt.png`} alt="" aria-hidden="true" /></button>}<time data-system-clock>4:20 PM</time></div>
        <div class="aero-start-panel" data-start-panel hidden><div class="aero-start-left"><label>Search programs and files <input aria-label="Search programs and files" /></label><button type="button">Internet Explorer</button><button type="button">Windows Media Player</button><button type="button">Paint</button><button type="button">All Programs</button></div><aside><strong>Alex</strong><button type="button">Documents</button><button type="button">Pictures</button><button type="button">Music</button><button type="button">Computer</button><button type="button">Control Panel</button><button type="button">Help and Support</button></aside></div>
      </>
    )}

    {release.id === "win8" && (
      <>
        <div class="metro-user"><span class="user-avatar"></span><b>Alex</b></div><h3 class="metro-heading">Start</h3><div class="metro-groups" aria-label="Start screen tiles"><div class="metro-grid"><button class="metro-tile wide tile-blue" type="button"><span class="line-icon mail-line"></span><b>Mail</b><small>3 new messages</small></button><button class="metro-tile tile-cyan" type="button"><span class="line-icon calendar-line">15</span><b>Calendar</b></button><button class="metro-tile tile-purple" type="button"><span class="line-icon people-line"></span><b>People</b></button><button class="metro-tile tile-orange" type="button"><span class="line-icon store-line"></span><b>Store</b></button><button class="metro-tile wide tile-green" type="button"><span class="weather-reading">18°</span><b>Weather</b><small>Sydney · Sunny</small></button><button class="metro-tile tile-red" type="button"><span class="line-icon camera-line"></span><b>Camera</b></button><button class="metro-tile tile-blue-dark" type="button"><span class="line-icon desktop-line"></span><b>Desktop</b></button><button class="metro-tile tile-command" type="button" data-command-external-open><img src={`${base}media/system-icons/Windows95MSDOSPrompt.png`} alt="" aria-hidden="true" /><b>Command Prompt</b></button><button class="metro-tile wide tile-photo" type="button"><b>Photos</b></button></div></div>
        <aside class="charms-bar" aria-label="Charms"><button type="button"><span class="charm search-charm"></span>Search</button><button type="button"><span class="charm share-charm"></span>Share</button><button type="button"><span class="charm start-charm"></span>Start</button><button type="button"><span class="charm devices-charm"></span>Devices</button><button type="button"><span class="charm settings-charm"></span>Settings</button></aside>
      </>
    )}

    {release.id === "win10" && (
      <>
        <div class="desktop-shortcuts win10-shortcuts" aria-label="Desktop items"><button type="button"><span class="flat-icon pc-flat"></span>This PC</button><button type="button"><span class="flat-icon bin-flat"></span>Recycle Bin</button></div>
        <article class="win10-window" data-window><header data-window-handle><span>Settings</span><div class="flat-caption"><button type="button" data-window-action="minimise" aria-label="Minimise">—</button><button type="button" data-window-action="maximise" aria-label="Maximise">□</button><button type="button" data-window-action="close" aria-label="Close">×</button></div></header><div class="settings-shell"><aside><label>Find a setting<input aria-label="Find a setting" /></label><b>Home</b><span>System</span><span>Devices</span><span>Network &amp; Internet</span><span>Personalization</span></aside><section><h3>Windows Settings</h3><div class="settings-grid"><button type="button"><span class="settings-icon monitor-setting"></span><b>System</b><small>Display, sound, notifications</small></button><button type="button"><span class="settings-icon device-setting"></span><b>Devices</b><small>Bluetooth, printers, mouse</small></button><button type="button"><span class="settings-icon network-setting"></span><b>Network &amp; Internet</b><small>Wi-Fi, airplane mode, VPN</small></button><button type="button"><span class="settings-icon person-setting"></span><b>Accounts</b><small>Your accounts, email, sync</small></button></div></section></div></article>
        <div class="win10-taskbar"><button class="start-button win10-start" type="button" data-start-button aria-expanded="false" aria-label="Start"><span class="flat-windows"><i></i><i></i><i></i><i></i></span></button><label class="task-search"><span class="search-symbol"></span><input aria-label="Search Windows" placeholder="Type here to search" /></label><button class="task-view" type="button" aria-label="Task View"><i></i></button><button class="flat-task settings-task" type="button" data-open-window aria-label="Settings"></button><time data-system-clock>4:20 PM</time></div>
        <div class="win10-start-panel" data-start-panel hidden><aside><button type="button" aria-label="User account"><span class="user-outline"></span></button><button type="button" aria-label="Documents"><span class="doc-outline"></span></button><button type="button" aria-label="Settings"><span class="gear-outline"></span></button><button type="button" aria-label="Power"><span class="power-outline"></span></button></aside><section><b>Recently added</b><button type="button">Calculator</button><button type="button">Microsoft Edge</button><button type="button">Photos</button><b>A</b><button type="button">Alarms &amp; Clock</button></section><div class="win10-tiles"><b>Life at a glance</b><button class="tile-blue" type="button">Mail</button><button class="tile-photo" type="button">Photos</button><button class="tile-cyan" type="button">Calendar</button><button class="tile-green" type="button">Xbox</button></div></div>
      </>
    )}

    {release.id === "win11" && (
      <>
        <div class="desktop-shortcuts win11-shortcuts" aria-label="Desktop items"><button type="button"><span class="fluent-icon pc-fluent"></span>This PC</button><button type="button"><span class="fluent-icon bin-fluent"></span>Recycle Bin</button></div>
        <article class="win11-window" data-window><header data-window-handle><span>Settings</span><div class="win11-caption"><button type="button" data-window-action="minimise" aria-label="Minimise">—</button><button class="snap-trigger" type="button" data-window-action="maximise" aria-label="Maximise and show snap layouts">□<span class="snap-layout" aria-hidden="true"><i></i><i></i><i></i><i></i></span></button><button type="button" data-window-action="close" aria-label="Close">×</button></div></header><div class="win11-settings"><aside><div class="account-chip"><span class="user-avatar"></span><b>Alex Morgan</b><small>Local account</small></div><label><input aria-label="Find a setting" placeholder="Find a setting" /></label><b>System</b><span>Bluetooth &amp; devices</span><span>Network &amp; internet</span><span>Personalisation</span><span>Apps</span><span>Accounts</span></aside><section><h3>System</h3><div class="device-hero"><span class="fluent-icon pc-fluent"></span><b>Alex's PC</b><small>Windows 11</small></div><button type="button"><span class="settings-icon monitor-setting"></span><b>Display</b><small>Monitors, brightness, night light</small></button><button type="button"><span class="settings-icon sound-setting"></span><b>Sound</b><small>Volume levels, output, input</small></button><button type="button"><span class="settings-icon bell-setting"></span><b>Notifications</b><small>Alerts from apps and system</small></button></section></div></article>
        <div class="win11-taskbar"><div class="win11-centre"><button class="start-button win11-start" type="button" data-start-button aria-expanded="true" aria-label="Start"><span class="flat-windows"><i></i><i></i><i></i><i></i></span></button><button class="win11-search" type="button" aria-label="Search"><span class="search-symbol"></span></button><button class="task-view" type="button" aria-label="Task View"><i></i></button><button class="fluent-task explorer-fluent" type="button" aria-label="File Explorer"></button><button class="fluent-task edge-fluent" type="button" aria-label="Microsoft Edge"></button></div><time data-system-clock>4:20 PM</time></div>
        <div class="win11-start-panel" data-start-panel><label><span class="search-symbol"></span><input aria-label="Search for apps, settings, and documents" placeholder="Type here to search" /></label><div class="pinned-title"><b>Pinned</b><button type="button">All apps &gt;</button></div><div class="pinned-grid"><button type="button"><span class="pinned-icon edge-pin"></span>Edge</button><button type="button"><span class="pinned-icon mail-pin"></span>Mail</button><button type="button"><span class="pinned-icon store-pin"></span>Store</button><button type="button"><span class="pinned-icon photos-pin"></span>Photos</button><button type="button"><span class="pinned-icon settings-pin"></span>Settings</button><button type="button"><span class="pinned-icon calc-pin"></span>Calculator</button></div><b class="recommended-title">Recommended</b><div class="recommended"><button type="button"><span class="doc-card"></span><b>Windows design notes</b><small>2h ago</small></button><button type="button"><span class="photo-card"></span><b>Desktop references</b><small>Yesterday</small></button></div><footer><button type="button"><span class="user-avatar"></span>Alex</button><button type="button" aria-label="Power"><span class="power-outline"></span></button></footer></div>
      </>
    )}

    <CommandPrompt release={release} base={base} />
  </div>
</section>
