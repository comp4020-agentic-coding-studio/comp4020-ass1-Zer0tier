---
import BsodEasterEgg from "../components/BsodEasterEgg.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  bodyClass?: string;
  bodyStyle?: string;
}

const { title, description, bodyClass = "", bodyStyle } = Astro.props;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
  </head>
  <body class={bodyClass} style={bodyStyle}>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <BsodEasterEgg />
  </body>
</html>
