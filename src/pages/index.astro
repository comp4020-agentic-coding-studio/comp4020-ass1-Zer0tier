---
import Base from "../layouts/Base.astro";
import TimelineEntry from "../components/TimelineEntry.astro";
import { windowsReleases } from "../data/windows";
import timelineInteractions from "../timeline-entry.js?raw";
import "../styles/global.css";

const base = import.meta.env.BASE_URL;
---

<Base title="Windows Desktop Evolution" description="Scroll through the evolution of Microsoft Windows, then click to enter the selected release." bodyClass="home-page">
  <TimelineEntry releases={windowsReleases} base={base} />
  <script is:inline set:html={timelineInteractions} />
</Base>
