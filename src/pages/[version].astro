---
import Base from "../layouts/Base.astro";
import AdoptionMilestone from "../components/AdoptionMilestone.astro";
import ClassicGame from "../components/ClassicGame.astro";
import Contributors from "../components/Contributors.astro";
import DesktopPreview from "../components/DesktopPreview.astro";
import MemoryScene from "../components/MemoryScene.astro";
import ReleaseQuiz from "../components/ReleaseQuiz.astro";
import ReleaseStory from "../components/ReleaseStory.astro";
import StartupSound from "../components/StartupSound.astro";
import XPSpiderEasterEgg from "../components/XPSpiderEasterEgg.astro";
import { getStartupSound } from "../data/windows-audio";
import { getWindowsHistory } from "../data/windows-history";
import { getWindowsMemoryScene } from "../data/windows-memories";
import { windowsReleases, type WindowsRelease } from "../data/windows";
import interactions from "../system-interactions.js?raw";
import gameInteractions from "../classic-games.js?raw";
import quizInteractions from "../release-quiz.js?raw";
import startupSoundInteractions from "../startup-sound.js?raw";
import memoryCapsuleInteractions from "../memory-capsule.js?raw";
import xpSpiderInteractions from "../xp-spider-easter-egg.js?raw";
import xpSpiderStyles from "../styles/xp-spider.css?raw";
import "../styles/global.css";

export function getStaticPaths() {
  return windowsReleases.map((release) => ({ params: { version: release.slug }, props: { release } }));
}

interface Props {
  release: WindowsRelease;
}

const { release } = Astro.props;
const base = import.meta.env.BASE_URL;
const currentIndex = windowsReleases.findIndex((item) => item.id === release.id);
const previous = windowsReleases[currentIndex - 1];
const next = windowsReleases[currentIndex + 1];
const history = getWindowsHistory(release.id);
const startupSound = getStartupSound(release.id);
const memoryScene = getWindowsMemoryScene(release.id);
const releaseHref = (slug: string) => `${base}${slug}/`;
const cursorHref = `${base}media/cursors/${release.slug}.cur`;
---

<Base title={`${release.name} — Windows Desktop Evolution`} description={`${release.summary} Explore a period-accurate interactive recreation of the ${release.name} desktop.`} bodyClass={`version-page page-${release.id}`} bodyStyle={`--system-cursor: url("${cursorHref}")`}>
  {release.id === "winxp" && <style is:inline set:html={xpSpiderStyles} />}
  <header class="site-header shell">
    <a class="wordmark" href={base} aria-label="Windows Desktop Evolution home"><span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span>Windows<br /><b>Desktop Evolution</b></span></a>
    <p>{String(currentIndex + 1).padStart(2, "0")} / {String(windowsReleases.length).padStart(2, "0")}</p>
  </header>

  <nav class="version-nav" aria-label="Windows versions" data-version-nav>
    <span class="version-nav-glider" data-version-nav-glider aria-hidden="true"></span>
    <ol class="shell">
      {windowsReleases.map((item, index) => <li><a href={releaseHref(item.slug)} data-version-index={index} aria-current={item.id === release.id ? "page" : undefined}><b>{item.shortName}</b><span>{item.year}</span></a></li>)}
    </ol>
  </nav>

  <StartupSound releaseName={release.name} sound={startupSound} base={base} />

  <main id="main" class="shell">
    <section class="version-hero" aria-labelledby="version-title">
      <div class="version-number" aria-hidden="true">{release.shortName}</div>
      <div><p class="eyebrow">{release.year} · {release.era}</p><h1 id="version-title">{release.name}</h1><p class="version-headline">{release.headline}</p></div>
      <p class="version-summary">{release.summary}</p>
    </section>

    <DesktopPreview release={release} base={base} />

    <AdoptionMilestone release={release} />

    <MemoryScene release={release} scene={memoryScene} base={base} />

    <ReleaseQuiz release={release} />

    <ClassicGame release={release} />

    <section id="details" class="release-details" aria-labelledby="details-heading">
      <div class="section-heading"><p class="eyebrow">System notes</p><h2 id="details-heading">What this interface changed</h2></div>
      <div class="detail-grid">
        <article><span>01</span><h3>Signature interface</h3><p>{release.signature}</p></article>
        <article><span>02</span><h3>The shift</h3><p>{release.changed}</p></article>
        <article><span>03</span><h3>The trade-off</h3><p>{release.tradeoff}</p></article>
        <article><span>04</span><h3>What remained</h3><p>{release.legacy}</p></article>
      </div>
    </section>

    <ReleaseStory releaseName={release.name} story={history.story} />

    <Contributors releaseName={release.name} contributors={history.contributors} base={base} />

    <nav class="release-pagination" aria-label="Adjacent Windows releases">
      {previous ? <a class="previous-release" href={releaseHref(previous.slug)}><span>← Previous</span><b>{previous.name}</b></a> : <span></span>}
      {next ? <a class="next-release" href={releaseHref(next.slug)}><span>Next →</span><b>{next.name}</b></a> : <a class="next-release" href={base}><span>Return to</span><b>All releases</b></a>}
    </nav>
  </main>

  <footer class="site-footer shell"><p>{release.name} · Windows Desktop Evolution</p><a href={base}>All releases</a></footer>
  {release.id === "winxp" && <XPSpiderEasterEgg base={base} />}
  <script is:inline set:html={interactions} />
  <script is:inline set:html={quizInteractions} />
  <script is:inline set:html={gameInteractions} />
  <script is:inline set:html={startupSoundInteractions} />
  <script is:inline set:html={memoryCapsuleInteractions} />
  {release.id === "winxp" && <script is:inline set:html={xpSpiderInteractions} />}
</Base>
