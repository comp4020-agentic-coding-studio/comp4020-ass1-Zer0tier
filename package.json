{
  "name": "comp4020-static-prototype",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm build && oxlint --ignore-path .gitignore && stylelint \"**/*.css\" --ignore-path .gitignore --allow-empty-input && vitest run",
    "check:browser": "pnpm build && playwright test",
    "check:evidence": "node scripts/check-evidence.ts",
    "check:links": "pnpm build && node scripts/prepare-pages-link-check.mjs && linkinator ./dist --silent",
    "test": "vitest run"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.0.0",
    "axe-core": "^4.13.0",
    "jsdom": "^29.1.1",
    "linkinator": "^8.0.3",
    "oxlint": "^1.75.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.9.0",
  "dependencies": {
    "astro": "^7.1.6"
  }
}
