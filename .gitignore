node_modules/
dist/
*.log
playwright-report/
test-results/

# editor and OS junk
.DS_Store
._*
Thumbs.db
Desktop.ini

# keep secrets out of the repo: your API key lives in an env var or an
# untracked file, never in a tracked one
.env
.env.*
.envrc
mise.local.toml
*.pem

# Claude Code's project directory is machine-local: settings in here can hold
# your course API key, and this repo goes public when you ship. Your tracked
# harness is CLAUDE.md (and any AGENTS.md), not this directory.
.claude/

# Astro generates this: type stubs and build info, all reproducible.
.astro/

# Skill packs that other agent tools unpack into the repo root: 74MB of the
# same third-party skills copied seventeen times over. They are a tool cache,
# not authored harness — this project's harness is CLAUDE.md — and committing
# them would bury the work a marker is here to read.
.agents/
.augment/
.codebuddy/
.codewhale/
.continue/
.cursor/
.factory/
.gemini/
.kilocode/
.kiro/
.opencode/
.qoder/
.roo/
.trae/
.warp/
.windsurf/
.github/prompts/
